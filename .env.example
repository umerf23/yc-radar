# Slack
SLACK_BOT_TOKEN=xoxb-your-token-here
SLACK_CHANNEL_ID=C0123456789

# Classifier. Set LLM_PROVIDER to 'none' to run keyword-only.
LLM_PROVIDER=gemini
LLM_API_KEY=your-gemini-key-here

# Data sources
TWITTERAPI_KEY=your-twitterapi-key-here
SERPER_KEY=your-serper-key-here

# Optional. Leave blank to disable Apify enrichment.
APIFY_TOKEN=
APIFY_POST_ACTOR=
APIFY_COMPANY_ACTOR=

# Optional. Overrides the database location, used in deployment.
YC_RADAR_DB_PATH=
